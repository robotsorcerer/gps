<?xml version="1.0"?>
<package format="3">
  <name>gps_agent_pkg</name>
  <version>1.0.0</version>
  <description>GPS (Guided Policy Search) ROS agent package with C++17 support</description>

  <maintainer email="patlekano@gmail.com">Olalekan Ogunmolu</maintainer>

  <license>BSD</license>

  <author email="cbfinn@eecs.berkeley.edu">Chelsea Finn</author>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Core Dependencies -->
  <depend>control_toolbox</depend>
  <depend>geometry_msgs</depend>
  <depend>orocos_kdl</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>eigen</depend>

  <!-- PR2 Specific Dependencies -->
  <depend>pr2_controller_interface</depend>
  <depend>pr2_controller_manager</depend>
  <depend>pr2_controllers_msgs</depend>
  <depend>pr2_mechanism_model</depend>

  <!-- Message Generation -->
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <export>
    <pr2_controller_interface plugin="${prefix}/controller_plugins.xml" />
  </export>
</package>
